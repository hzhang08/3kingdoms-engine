{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caocao-game",
  "main": "src/worker.ts",
  "account_id": "ad9fe8d09042662dde159d59992cf1bd",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern":"3kingdoms.cc.cd","custom_domain":true}],
  "assets": {"directory":"dist","binding":"ASSETS","run_worker_first":["/api/*"],"not_found_handling":"single-page-application"},
  "vars": {"APP_ORIGIN":"https://3kingdoms.cc.cd","JEV_DAILY_USER_LIMIT":"720","JEV_DAILY_GLOBAL_LIMIT":"5000"},
  "d1_databases": [{"binding":"DB","database_name":"caocao-game","database_id":"7cbce041-f6c8-4037-93bb-511aba60b253","migrations_dir":"migrations"}],
  "observability": {"enabled":true,"head_sampling_rate":0.1}
}
