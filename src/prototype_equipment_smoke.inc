#ifndef __EMSCRIPTEN__
void equipment_smoke(const std::filesystem::path& out){
 std::filesystem::create_directories(out);jev_enabled=false;
 auto check=[](bool ok,const char* why){if(!ok)throw std::runtime_error(why);};
 auto drain=[](){for(int n=0;n<2000;++n){if(playback.active()){playback.advance(100000);playback.take_sounds();}else if(game->has_dialogue()){game->command("continue");collect_presentation();}else if(!game->story_choices().empty()){game->choose_story(0);collect_presentation();}else return;}throw std::runtime_error("UI fixture dialogue stalled");};
 auto tap=[&](SDL_FRect r){float x,y;SDL_RenderCoordinatesToWindow(renderer,r.x+r.w/2,r.y+r.h/2,&x,&y);SDL_Event e{};e.type=SDL_EVENT_MOUSE_BUTTON_DOWN;e.button.button=SDL_BUTTON_LEFT;e.button.x=x;e.button.y=y;SDL_PushEvent(&e);tick();};
 auto key=[&](SDL_Keycode k){SDL_Event e{};e.type=SDL_EVENT_KEY_DOWN;e.key.key=k;SDL_PushEvent(&e);tick();};
 drain();auto initial=game->serialize();tap(treasure_button);check(show_inventory&&treasure_view,"treasure button not working");check(owned_equipment().size()==1&&owned_equipment()[0].at("item").at(0)==23,"enemy treasures leaked into inventory");key(SDLK_J);key(SDLK_E);check(game->serialize()==initial,"treasure view leaked a command");draw(out/"treasures-battle.bmp");
 tap(treasure_owner);check(show_unit_details&&detail_tab==1,"treasure-to-owner link failed");tap(detail_equip_button);check(equipment_slot_ui<0&&game->serialize()==initial,"battle equip was allowed");key(SDLK_F6);check(!show_slots&&show_unit_details,"inspector leaked slot modal");draw(out/"equipment-readonly.bmp");key(SDLK_ESCAPE);
 auto actor=game->state().at("units").at("0").at("battle");send("tile",actor.at("x"),actor.at("y"));auto costs=game->movement();bool moved=false;
 for(int p=0;p<game->cell_count()&&!moved;++p)if(costs[p]>0&&costs[p]!=255){bool occupied=false;for(const auto& u:game->state().at("units"))if(u.at("battle").at("hp").get<int>()>0&&u.at("battle").at("x")==p%game->map_width()&&u.at("battle").at("y")==p/game->map_width())occupied=true;if(!occupied)moved=send("tile",p%game->map_width(),p/game->map_width());}
 check(moved,"treasure move fixture failed");drain();auto pending=game->serialize();key(SDLK_G);check(show_inventory&&treasure_view,"treasure did not open during pending move");key(SDLK_ESCAPE);check(action_menu_unit==0&&game->serialize()==pending,"treasure view lost pending movement menu");restore_snapshot(initial);

 auto terminal=Json::parse(initial);for(auto& u:terminal["payload"]["state"]["units"])if(u.at("battle").at("side").get<int>()>=2){u["battle"]["hp"]=0;u["battle"]["lifecycle"]=3;}
 terminal["sha256"]=sha256(terminal.at("payload").dump());restore_snapshot(terminal.dump());auto b=game->state().at("units").at("0").at("battle");send("tile",b.at("x"),b.at("y"));send("wait");drain();check(game->state().at("phase")=="victory","UI fixture victory failed");
 tap(camp_button);check(show_unit_details&&detail_tab==1,"victory preparation button missing");key(SDLK_ESCAPE);key(SDLK_G);check(show_inventory&&treasure_view&&owned_equipment().size()==2,"reward missing in treasure view");draw(out/"treasures-reward.bmp");tap(treasure_owner);tap(detail_equip_button);check(equipment_slot_ui==0,"camp equipment picker missing");tap({582,312,188,36});check(equipment_slot_ui==2&&equipment_choices().size()==2,"eligible treasure not offered");tap(gear_row(1));draw(out/"equipment-choose.bmp");auto before=game->serialize();tap(gear_cancel);check(game->serialize()==before,"cancel changed equipment");
 tap(detail_equip_button);tap({582,312,188,36});tap(gear_row(1));tap(gear_confirm);check(equipment_slot_ui<0&&game->state().at("units").at("0").at("record").at("equipment")[2][0]==76,"equipment confirmation failed");draw(out/"equipped-treasure.bmp");key(SDLK_ESCAPE);key(SDLK_F5);check(notice=="已保存。","equipment save failed");auto saved=game->serialize();key(SDLK_F9);check(game->serialize()==saved,"equipment load changed state");
 for(auto size:{std::array{720,840},std::array{1200,960}}){SDL_SetWindowSize(window,size[0],size[1]);SDL_SyncWindow(window);tap(treasure_button);check(show_inventory&&treasure_view,"scaled treasure input failed");tap(treasure_owner);tap(detail_equip_button);check(equipment_slot_ui==0,"scaled equipment input failed");tap(gear_cancel);for(int n=0;n<5;++n){tap(unit_tab_rect(n));check(detail_tab==n,"scaled tab input failed");draw(out/("camp-"+std::to_string(size[0])+"-tab-"+std::to_string(n)+".bmp"));}key(SDLK_ESCAPE);check(game->serialize()==saved,"modal changed saved battle");}
 std::ofstream(out/"verification.json")<<Json{{"treasure_view",true},{"earned_and_equipped_ownership",true},{"between_battles_only",true},{"cancel_nonmutating",true},{"equipment_confirmed",true},{"five_tabs_scaled_input",true},{"manual_slot_roundtrip",true},{"renderer",SDL_GetRendererName(renderer)}}.dump(2)<<'\n';
 std::cout<<"Equipment UI passed: treasure/ownership, post-battle swap, cancel, save/load, five tabs and two viewport sizes.\n";
}
