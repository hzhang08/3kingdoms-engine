# Source-only GitHub repository. Keep local artwork, game data and credentials out.
/*
!/.gitignore
!/.dockerignore
!/CMakeLists.txt
!/README.md
!/SOURCE_ONLY.md
!/THIRD_PARTY.md
!/dependencies.lock.json
!/requirements.txt
!/src/
!/include/
!/tests/
!/scripts/
!/tools/
!/docs/
!/third_party/
!/web/
!/web-game/
!/assets/
/assets/*
!/assets/localization/
/docs/*/
/web-game/*
!/web-game/.gitignore
!/web-game/.dev.vars.example
!/web-game/README.md
!/web-game/package.json
!/web-game/package-lock.json
!/web-game/tsconfig*.json
!/web-game/wrangler*.json
!/web-game/wrangler*.jsonc
!/web-game/src/
!/web-game/client/
!/web-game/scripts/
!/web-game/tests/
!/web-game/migrations/

# Dependencies, build results, private state and diagnostic material.
node_modules/
.wrangler/
.venv/
.cache/
build*/
dist/
output/
tmp/
__pycache__/
*.pyc
.DS_Store
.env
.env.*
.dev.vars*
!.dev.vars.example
*.secret.json
*credentials*
*.pem
*.key
*.p12
*.pfx
*.log
*.sqlite*
*.db
*.e5s
*.exe
*.dll
*.wasm
*.data
*.zip
*.dmg
*.app/

# No images, sprites, fonts, audio, movies, or 3D asset files.
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[gG][iI][fF]
*.[bB][mM][pP]
*.[wW][eE][bB][pP]
*.[sS][vV][gG]
*.ico
*.icns
*.avif
*.heic
*.tif
*.tiff
*.pdf
*.ttf
*.otf
*.woff*
*.mp3
*.wav
*.ogg
*.flac
*.avi
*.mp4
*.mov
*.webm
*.blend
*.glb
*.gltf
*.obj
*.fbx

# These reference captures include inline raster pixels; regenerate locally.
/tests/fixtures/original_terrain_panel.json
/tests/fixtures/original_tutorial_terrain.json
